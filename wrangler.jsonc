{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roofer",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "roof.miami",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
